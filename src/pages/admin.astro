---
import Base from '../layouts/Base.astro';
import { Check, Copy, KeyRound, LogOut, RefreshCw, Trash2 } from '@lucide/astro';

const fieldClass =
  'w-full rounded-lg border border-white/10 bg-white/[0.03] px-3 py-2 text-sm text-zinc-200 placeholder:text-zinc-600 focus:border-emerald-400/50 focus:outline-none';
---

<Base title="Admin — MITS" noindex>
  <div class="mx-auto max-w-4xl px-4 py-12">
    <div class="flex items-center justify-between">
      <h1 class="text-2xl font-bold tracking-tight text-zinc-100">Admin — suggestion queue</h1>
      <button id="logout" class="hidden items-center gap-1.5 font-mono text-xs text-zinc-500 hover:text-zinc-300" type="button">
        <LogOut class="size-3.5" aria-hidden="true" /> clear tokens
      </button>
    </div>
    <p class="mt-2 text-sm text-zinc-500">
      Local-only page. Tokens stay in this browser's localStorage and are sent only to the suggest API and the GitHub API.
    </p>

    <!-- token gate -->
    <section id="gate" class="mt-8 rounded-xl border border-white/10 bg-white/[0.02] p-5">
      <h2 class="flex items-center gap-2 font-semibold text-zinc-100">
        <KeyRound class="size-4 text-emerald-400" aria-hidden="true" /> Credentials
      </h2>
      <div class="mt-4 space-y-4">
        <div>
          <label for="in-token" class="mb-1.5 block font-mono text-[11px] uppercase tracking-wider text-zinc-500">Admin token (suggest queue)</label>
          <input id="in-token" type="password" autocomplete="off" class={fieldClass} placeholder="ADMIN_TOKEN" />
        </div>
        <div>
          <label for="in-pat" class="mb-1.5 block font-mono text-[11px] uppercase tracking-wider text-zinc-500">GitHub token (to commit accepted entries — needs Contents: Read &amp; write)</label>
          <input id="in-pat" type="password" autocomplete="off" class={fieldClass} placeholder="ghp_… / github_pat_…" />
        </div>
        <button id="btn-save" type="button" class="btn btn-primary">Save &amp; load queue</button>
        <p id="gate-status" class="text-sm text-red-300" hidden></p>
      </div>
    </section>

    <!-- queue -->
    <section id="queue" class="mt-8" hidden>
      <div class="flex items-center justify-between">
        <p class="font-mono text-xs text-zinc-500"><span id="count">0</span> suggestion(s) queued</p>
        <button id="btn-refresh" type="button" class="btn btn-ghost !px-3 !py-1.5 text-xs">
          <RefreshCw class="size-3.5" aria-hidden="true" /> Refresh
        </button>
      </div>
      <div id="list" class="mt-4 space-y-4"></div>
    </section>
  </div>
</Base>

<script>
  const apiBase = import.meta.env.PUBLIC_SUGGEST_API_URL || 'http://localhost:8787';
  const repo = ((import.meta.env.PUBLIC_REPO_URL as string | undefined) || 'https://github.com/khaifmono/mits')
    .replace('https://github.com/', '')
    .replace(/\/$/, '');
  const LS_TOKEN = 'mits_admin_token';
  const LS_PAT = 'mits_gh_pat';

  const CATEGORIES = ['PaaS & Containers', 'Identity & Auth', 'Observability & Uptime', 'Storage & Sync', 'Developer Tools', 'Local AI', 'Office & Knowledge'];
  const INDEPENDENCE = ['100% Sovereign', 'Federated', 'Open Core'];
  const RESOURCES = ['Light (<512MB RAM)', 'Medium (1-2GB RAM)', 'Heavy (4GB+ RAM)'];

  const gate = document.getElementById('gate')!;
  const queue = document.getElementById('queue')!;
  const list = document.getElementById('list')!;
  const count = document.getElementById('count')!;
  const gateStatus = document.getElementById('gate-status')!;
  const logoutBtn = document.getElementById('logout') as HTMLButtonElement;

  const getToken = () => localStorage.getItem(LS_TOKEN) ?? '';
  const getPat = () => localStorage.getItem(LS_PAT) ?? '';

  const esc = (s: string): string =>
    s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);

  const slugify = (name: string): string =>
    name.toLowerCase().trim().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '') || 'tool-slug';

  function ghHeaders(): HeadersInit {
    return {
      authorization: `Bearer ${getPat()}`,
      accept: 'application/vnd.github+json',
      'x-github-api-version': '2022-11-28',
      'content-type': 'application/json',
    };
  }

  interface Suggestion {
    id: string; name: string; url: string; replaces: string; category: string; notes: string; contact: string; ts: number;
  }

  async function loadQueue(): Promise<void> {
    gateStatus.hidden = true;
    const res = await fetch(`${apiBase}/suggest`, { headers: { 'x-admin-token': getToken() } });
    if (res.status === 401) {
      gate.hidden = false;
      queue.hidden = true;
      gateStatus.textContent = 'Bad admin token — try again.';
      gateStatus.hidden = false;
      return;
    }
    if (!res.ok) throw new Error(`HTTP ${res.status}`);
    const data = (await res.json()) as { suggestions: Suggestion[] };
    gate.hidden = true;
    queue.hidden = false;
    logoutBtn.classList.remove('hidden');
    logoutBtn.classList.add('inline-flex');
    render(data.suggestions);
  }

  function render(suggestions: Suggestion[]): void {
    count.textContent = String(suggestions.length);
    list.innerHTML = '';
    if (suggestions.length === 0) {
      list.innerHTML = '<p class="rounded-lg border border-white/10 bg-white/[0.02] p-4 text-sm text-zinc-500">Queue is empty.</p>';
      return;
    }
    for (const s of suggestions) list.appendChild(card(s));
  }

  function card(s: Suggestion): HTMLElement {
    const el = document.createElement('article');
    el.className = 'rounded-xl border border-white/10 bg-white/[0.02] p-5';
    el.dataset.id = s.id;
    el.innerHTML = `
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div>
          <h3 class="font-semibold text-zinc-100">${esc(s.name)}</h3>
          <a href="${esc(s.url) || '#'}" target="_blank" rel="noopener noreferrer" class="font-mono text-xs text-emerald-400/80 hover:underline">${esc(s.url) || 'no url'}</a>
        </div>
        <div class="flex gap-2">
          <button type="button" data-act="copy" class="btn btn-ghost !px-3 !py-1.5 text-xs"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>Copy JSON</button>
          <button type="button" data-act="accept" class="btn btn-primary !px-3 !py-1.5 text-xs">Accept → commit</button>
          <button type="button" data-act="delete" class="btn !px-3 !py-1.5 border border-red-400/30 bg-red-400/10 text-xs text-red-300 hover:bg-red-400/20">Delete</button>
        </div>
      </div>
      <dl class="mt-3 grid gap-x-6 gap-y-1 text-xs sm:grid-cols-2">
        <div><dt class="inline font-mono text-zinc-600">replaces: </dt><dd class="inline text-zinc-400">${esc(s.replaces) || '—'}</dd></div>
        <div><dt class="inline font-mono text-zinc-600">category: </dt><dd class="inline text-zinc-400">${esc(s.category) || '—'}</dd></div>
      </dl>
      ${s.notes ? `<p class="mt-2 text-sm leading-relaxed text-zinc-400">${esc(s.notes)}</p>` : ''}
      ${s.contact ? `<p class="mt-1 font-mono text-[11px] text-zinc-600">by ${esc(s.contact)}</p>` : ''}
      <div class="editor mt-4 hidden"></div>
      <p class="msg mt-3 text-sm" hidden></p>`;
    return el;
  }

  function openEditor(el: HTMLElement, s: Suggestion): void {
    const editor = el.querySelector('.editor') as HTMLElement;
    const today = new Date().toISOString().slice(0, 10);
    editor.innerHTML = `
      <div class="grid gap-3 rounded-lg border border-white/10 bg-black/30 p-4 sm:grid-cols-2">
        <div><label class="mb-1 block font-mono text-[10px] uppercase text-zinc-600">Name</label><input data-f="name" value="${esc(s.name)}" class="w-full rounded border border-white/10 bg-white/[0.03] px-2 py-1.5 text-sm text-zinc-200"></div>
        <div><label class="mb-1 block font-mono text-[10px] uppercase text-zinc-600">id (slug)</label><input data-f="id" value="${slugify(s.name)}" class="w-full rounded border border-white/10 bg-white/[0.03] px-2 py-1.5 font-mono text-sm text-zinc-200"></div>
        <div class="sm:col-span-2"><label class="mb-1 block font-mono text-[10px] uppercase text-zinc-600">Tagline</label><input data-f="tagline" class="w-full rounded border border-white/10 bg-white/[0.03] px-2 py-1.5 text-sm text-zinc-200"></div>
        <div class="sm:col-span-2"><label class="mb-1 block font-mono text-[10px] uppercase text-zinc-600">Description</label><textarea data-f="description" rows="3" class="w-full rounded border border-white/10 bg-white/[0.03] px-2 py-1.5 text-sm text-zinc-200">${esc(s.notes)}</textarea></div>
        <div><label class="mb-1 block font-mono text-[10px] uppercase text-zinc-600">Category</label><select data-f="category" class="w-full rounded border border-white/10 bg-white/[0.03] px-2 py-1.5 text-sm text-zinc-200"><option value="">—</option>${CATEGORIES.map((c) => `<option ${s.category === c ? 'selected' : ''}>${c}</option>`).join('')}</select></div>
        <div><label class="mb-1 block font-mono text-[10px] uppercase text-zinc-600">Replaces (comma-separated)</label><input data-f="alternativeTo" value="${esc(s.replaces)}" class="w-full rounded border border-white/10 bg-white/[0.03] px-2 py-1.5 text-sm text-zinc-200"></div>
        <div><label class="mb-1 block font-mono text-[10px] uppercase text-zinc-600">siteUrl</label><input data-f="siteUrl" value="${esc(s.url)}" class="w-full rounded border border-white/10 bg-white/[0.03] px-2 py-1.5 text-sm text-zinc-200"></div>
        <div><label class="mb-1 block font-mono text-[10px] uppercase text-zinc-600">repoUrl</label><input data-f="repoUrl" class="w-full rounded border border-white/10 bg-white/[0.03] px-2 py-1.5 text-sm text-zinc-200"></div>
        <div><label class="mb-1 block font-mono text-[10px] uppercase text-zinc-600">License</label><input data-f="license" class="w-full rounded border border-white/10 bg-white/[0.03] px-2 py-1.5 text-sm text-zinc-200"></div>
        <div><label class="mb-1 block font-mono text-[10px] uppercase text-zinc-600">Independence</label><select data-f="independenceLevel" class="w-full rounded border border-white/10 bg-white/[0.03] px-2 py-1.5 text-sm text-zinc-200">${INDEPENDENCE.map((i) => `<option>${i}</option>`).join('')}</select></div>
        <div><label class="mb-1 block font-mono text-[10px] uppercase text-zinc-600">Resources</label><select data-f="resourceRequirement" class="w-full rounded border border-white/10 bg-white/[0.03] px-2 py-1.5 text-sm text-zinc-200">${RESOURCES.map((r) => `<option>${r}</option>`).join('')}</select></div>
        <div><label class="mb-1 block font-mono text-[10px] uppercase text-zinc-600">Added</label><input data-f="addedAt" type="date" value="${today}" class="w-full rounded border border-white/10 bg-white/[0.03] px-2 py-1.5 text-sm text-zinc-200"></div>
        <div class="flex items-center gap-2"><input data-f="featured" type="checkbox" id="feat-${s.id}" class="size-4"><label for="feat-${s.id}" class="text-sm text-zinc-400">Featured</label></div>
        <p class="err sm:col-span-2 text-xs text-red-300" hidden></p>
        <div class="sm:col-span-2"><button type="button" data-act="commit" class="btn btn-primary w-full justify-center">Commit to data/tools.json</button></div>
      </div>`;
    editor.classList.remove('hidden');
    editor.querySelector('[data-act="commit"]')?.addEventListener('click', () => commit(el, s));
  }

  function collectEntry(el: HTMLElement): Record<string, unknown> {
    const f = (name: string): string => (el.querySelector(`[data-f="${name}"]`) as HTMLInputElement)?.value?.trim() ?? '';
    return {
      id: f('id'),
      name: f('name'),
      tagline: f('tagline'),
      description: f('description'),
      category: f('category'),
      alternativeTo: f('alternativeTo').split(',').map((a) => a.trim()).filter(Boolean),
      repoUrl: f('repoUrl') || null,
      siteUrl: f('siteUrl'),
      license: f('license') || null,
      independenceLevel: f('independenceLevel'),
      resourceRequirement: f('resourceRequirement'),
      featured: (el.querySelector('[data-f="featured"]') as HTMLInputElement)?.checked ?? false,
      dockerCompose: null,
      addedAt: f('addedAt'),
    };
  }

  function validate(entry: Record<string, unknown>): string[] {
    const errors: string[] = [];
    if (!/^[a-z0-9]+(-[a-z0-9]+)*$/.test(String(entry.id))) errors.push('id must be a kebab-case slug');
    for (const k of ['name', 'tagline', 'description']) if (!entry[k]) errors.push(`${k} is required`);
    if (!Array.isArray(entry.alternativeTo) || entry.alternativeTo.length === 0) errors.push('alternativeTo needs at least one entry');
    if (!/^https?:\/\/\S+$/.test(String(entry.siteUrl))) errors.push('siteUrl must be an http(s) URL');
    if (entry.repoUrl && !/^https?:\/\/\S+$/.test(String(entry.repoUrl))) errors.push('repoUrl must be an http(s) URL');
    if (!CATEGORIES.includes(String(entry.category))) errors.push('pick a category');
    if (!INDEPENDENCE.includes(String(entry.independenceLevel))) errors.push('pick an independence level');
    if (!RESOURCES.includes(String(entry.resourceRequirement))) errors.push('pick a resource requirement');
    if (!/^\d{4}-\d{2}-\d{2}$/.test(String(entry.addedAt))) errors.push('addedAt must be YYYY-MM-DD');
    return errors;
  }

  async function commit(el: HTMLElement, s: Suggestion): Promise<void> {
    const msg = el.querySelector('.msg') as HTMLElement;
    const err = el.querySelector('.err') as HTMLElement;
    err.hidden = true;
    const entry = collectEntry(el);
    const problems = validate(entry);
    if (problems.length > 0) {
      err.textContent = problems.join(' · ');
      err.hidden = false;
      return;
    }
    if (!getPat()) {
      msg.textContent = 'Missing GitHub token — add it at the top of the page.';
      msg.className = 'msg mt-3 text-sm text-red-300';
      msg.hidden = false;
      return;
    }

    msg.textContent = 'Fetching data/tools.json from GitHub…';
    msg.className = 'msg mt-3 text-sm text-zinc-400';
    msg.hidden = false;

    try {
      const fileUrl = `https://api.github.com/repos/${repo}/contents/data/tools.json?ref=main`;
      const get = await fetch(fileUrl, { headers: ghHeaders() });
      if (!get.ok) throw new Error(`GitHub GET failed: ${get.status}`);
      const meta = (await get.json()) as { sha: string; content: string };
      const current = JSON.parse(new TextDecoder().decode(Uint8Array.from(atob(meta.content), (c) => c.charCodeAt(0)))) as Record<string, unknown>[];
      if (current.some((t) => t.id === entry.id)) throw new Error(`id "${entry.id}" already exists in tools.json`);
      current.push(entry);
      const b64 = btoa(String.fromCharCode(...new TextEncoder().encode(JSON.stringify(current, null, 2))));

      msg.textContent = 'Committing…';
      const put = await fetch(`https://api.github.com/repos/${repo}/contents/data/tools.json`, {
        method: 'PUT',
        headers: ghHeaders(),
        body: JSON.stringify({
          message: `accept suggestion: ${s.name}`,
          content: b64,
          sha: meta.sha,
          branch: 'main',
        }),
      });
      if (!put.ok) throw new Error(`GitHub PUT failed: ${put.status} ${(await put.json()).message ?? ''}`);

      msg.textContent = 'Committed ✓ — deleting from queue…';
      await deleteSuggestion(s.id, el, true);
      msg.textContent = `Accepted ✓ — "${s.name}" committed to tools.json. Auto-deploy running…`;
      msg.className = 'msg mt-3 text-sm text-emerald-300';
    } catch (e) {
      msg.textContent = e instanceof Error ? e.message : 'Unknown error';
      msg.className = 'msg mt-3 text-sm text-red-300';
    }
  }

  async function deleteSuggestion(id: string, el?: HTMLElement, silent = false): Promise<void> {
    const res = await fetch(`${apiBase}/suggest?id=${encodeURIComponent(id)}`, {
      method: 'DELETE',
      headers: { 'x-admin-token': getToken() },
    });
    if (!res.ok && !silent) {
      const msg = el?.querySelector('.msg') as HTMLElement | null;
      if (msg) {
        msg.textContent = `Delete failed: HTTP ${res.status}`;
        msg.className = 'msg mt-3 text-sm text-red-300';
        msg.hidden = false;
      }
      return;
    }
    el?.remove();
    count.textContent = String(Number(count.textContent ?? '1') - 1);
  }

  // wiring
  (document.getElementById('btn-save') as HTMLButtonElement).addEventListener('click', () => {
    const token = (document.getElementById('in-token') as HTMLInputElement).value.trim();
    const pat = (document.getElementById('in-pat') as HTMLInputElement).value.trim();
    if (!token) {
      gateStatus.textContent = 'Admin token is required.';
      gateStatus.hidden = false;
      return;
    }
    localStorage.setItem(LS_TOKEN, token);
    localStorage.setItem(LS_PAT, pat);
    loadQueue().catch((e) => {
      gateStatus.textContent = `Load failed: ${e.message}`;
      gateStatus.hidden = false;
    });
  });

  (document.getElementById('btn-refresh') as HTMLButtonElement).addEventListener('click', () => loadQueue());

  logoutBtn.addEventListener('click', () => {
    localStorage.removeItem(LS_TOKEN);
    localStorage.removeItem(LS_PAT);
    queue.hidden = true;
    gate.hidden = false;
    logoutBtn.classList.add('hidden');
  });

  list.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('button[data-act]') as HTMLButtonElement | null;
    if (!btn) return;
    const el = btn.closest('article') as HTMLElement;
    const id = el.dataset.id!;
    const name = el.querySelector('h3')?.textContent ?? '';
    const s: Suggestion = { id, name, url: el.querySelector('a')?.textContent ?? '', replaces: '', category: '', notes: '', contact: '', ts: 0 };
    if (btn.dataset.act === 'accept') openEditor(el, s);
    if (btn.dataset.act === 'copy') {
      const entry = collectEntry(el);
      navigator.clipboard.writeText(JSON.stringify(entry, null, 2)).catch(() => {});
      const original = btn.innerHTML;
      btn.innerHTML = 'Copied ✓';
      setTimeout(() => (btn.innerHTML = original), 1500);
    }
    if (btn.dataset.act === 'delete') {
      if (confirm(`Delete suggestion "${name}"?`)) deleteSuggestion(id, el);
    }
  });

  if (getToken()) {
    loadQueue().catch((e) => {
      gateStatus.textContent = `Load failed: ${e.message}`;
      gateStatus.hidden = false;
    });
  }
</script>
