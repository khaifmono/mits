---
import Base from '../../layouts/Base.astro';
import { Activity, ArrowUpRight, Database, GitFork, Package, WifiOff } from '@lucide/astro';
import { RESOURCE_SHORT, tools } from '../../lib/tools';
import type { Tool } from '../../lib/tools';

export function getStaticPaths() {
  return tools.map((tool) => ({ params: { slug: tool.id }, props: { tool } }));
}

interface Props {
  tool: Tool;
}

const { tool } = Astro.props;
const related = tools.filter((t) => t.category === tool.category && t.id !== tool.id).slice(0, 3);
const metaRows: [string, string][] = [
  ['License', tool.license ?? 'Not tracked'],
  ['Independence', tool.independenceLevel],
  ['Resources', tool.resourceRequirement],
  ['Added', tool.addedAt],
];
---

<Base title={`${tool.name} — MITS`} description={tool.tagline}>
  <article class="mx-auto max-w-5xl px-4 py-10">
    <nav class="font-mono text-xs text-zinc-500" aria-label="Breadcrumb">
      <a href="/" class="hover:text-emerald-400">explore</a>
      <span class="mx-1">/</span>
      <span class="text-zinc-400">{tool.category.toLowerCase()}</span>
    </nav>

    <header class="mt-6 flex flex-wrap items-start justify-between gap-4">
      <div>
        <div class="flex flex-wrap items-center gap-3">
          <h1 class="text-3xl font-bold tracking-tight text-zinc-100">{tool.name}</h1>
          {
            tool.featured && (
              <span class="rounded border border-amber-400/20 bg-amber-400/10 px-1.5 py-0.5 font-mono text-[10px] tracking-wider text-amber-300">
                FEATURED
              </span>
            )
          }
        </div>
        <p class="mt-2 text-zinc-400">{tool.tagline}</p>
        <div class="mt-4 flex flex-wrap gap-1.5 font-mono text-[11px]">
          <span class="rounded border border-emerald-400/20 bg-emerald-400/10 px-1.5 py-0.5 text-emerald-300">{tool.category}</span>
          <span class="rounded border border-violet-400/20 bg-violet-400/10 px-1.5 py-0.5 text-violet-300">{tool.independenceLevel}</span>
          {
            tool.license && (
              <span class="rounded border border-sky-400/20 bg-sky-400/10 px-1.5 py-0.5 text-sky-300">
                {tool.license}
              </span>
            )
          }
          <span class="rounded border border-white/10 bg-white/5 px-1.5 py-0.5 text-zinc-400">
            {RESOURCE_SHORT[tool.resourceRequirement]}
          </span>
        </div>
      </div>
      <div class="flex gap-2">
        <a href={tool.siteUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
          Official site
          <ArrowUpRight class="size-4" aria-hidden="true" />
        </a>
        {
          tool.repoUrl && (
            <a href={tool.repoUrl} target="_blank" rel="noopener noreferrer" class="btn btn-ghost">
              <GitFork class="size-4" aria-hidden="true" />
              Source
            </a>
          )
        }
      </div>
    </header>

    <section class="mt-8" aria-label="Proprietary alternatives replaced">
      <h2 class="section-title">Replaces</h2>
      <div class="mt-2 flex flex-wrap gap-2">
        {
          tool.alternativeTo.map((a) => (
            <span class="rounded-md border border-white/10 bg-white/5 px-2.5 py-1 text-sm text-zinc-300">{a}</span>
          ))
        }
      </div>
    </section>

    <div class="mt-10 grid gap-10 lg:grid-cols-3">
      <div class="space-y-10 lg:col-span-2">
        <section aria-label="Overview">
          <h2 class="section-title">Overview</h2>
          <p class="mt-3 leading-relaxed text-zinc-300">{tool.description}</p>
        </section>

        {
          tool.independence && (
            <section aria-label="Why it's independent">
              <h2 class="section-title">Why it's independent</h2>
              <dl class="mt-3 space-y-3">
                <div class="flex gap-4 rounded-lg border border-white/10 bg-white/[0.02] p-4">
                  <Database class="mt-0.5 size-5 shrink-0 text-emerald-400" aria-hidden="true" />
                  <div>
                    <dt class="text-sm font-medium text-zinc-200">Data format</dt>
                    <dd class="mt-1 text-sm leading-relaxed text-zinc-400">{tool.independence.dataFormat}</dd>
                  </div>
                </div>
                <div class="flex gap-4 rounded-lg border border-white/10 bg-white/[0.02] p-4">
                  <Activity class="mt-0.5 size-5 shrink-0 text-emerald-400" aria-hidden="true" />
                  <div>
                    <dt class="text-sm font-medium text-zinc-200">Telemetry</dt>
                    <dd class="mt-1 text-sm leading-relaxed text-zinc-400">{tool.independence.telemetry}</dd>
                  </div>
                </div>
                <div class="flex gap-4 rounded-lg border border-white/10 bg-white/[0.02] p-4">
                  <WifiOff class="mt-0.5 size-5 shrink-0 text-emerald-400" aria-hidden="true" />
                  <div>
                    <dt class="text-sm font-medium text-zinc-200">Offline capability</dt>
                    <dd class="mt-1 text-sm leading-relaxed text-zinc-400">{tool.independence.offline}</dd>
                  </div>
                </div>
              </dl>
            </section>
          )
        }
      </div>

      <aside class="space-y-6">
        <dl class="divide-y divide-white/5 rounded-lg border border-white/10 bg-white/[0.02] px-4 text-sm">
          {
            metaRows.map(([k, v]) => (
              <div class="flex items-center justify-between gap-4 py-3">
                <dt class="text-zinc-500">{k}</dt>
                <dd class="text-right font-mono text-xs text-zinc-300">{v}</dd>
              </div>
            ))
          }
        </dl>

        {
          tool.dockerCompose ? (
            <section aria-label="Quick launch">
              <div class="flex items-center justify-between rounded-t-lg border border-white/10 bg-white/[0.03] px-4 py-2.5">
                <span class="font-mono text-xs text-zinc-400">docker-compose.yml</span>
                <button
                  type="button"
                  data-copy="compose-code"
                  class="font-mono text-xs text-emerald-400 transition hover:text-emerald-300 disabled:opacity-60"
                >
                  Copy
                </button>
              </div>
              <pre
                class="overflow-x-auto rounded-b-lg border border-t-0 border-white/10 bg-black/50 p-4 font-mono text-xs leading-relaxed text-zinc-300"><code id="compose-code">{tool.dockerCompose}</code></pre>
            </section>
          ) : (
            <div class="rounded-lg border border-white/10 bg-white/[0.02] p-4">
              <div class="flex items-center gap-2 text-sm font-medium text-zinc-300">
                <Package class="size-4 text-emerald-400" aria-hidden="true" />
                Native app
              </div>
              <p class="mt-2 text-sm leading-relaxed text-zinc-500">
                No Docker needed — download and run locally from the official site.
              </p>
            </div>
          )
        }
      </aside>
    </div>

    {
      related.length > 0 && (
        <section class="mt-12 border-t border-white/10 pt-8" aria-label="Related tools">
          <h2 class="section-title">More in {tool.category}</h2>
          <div class="mt-4 grid gap-3 sm:grid-cols-3">
            {related.map((t) => (
              <a
                href={`/tool/${t.id}`}
                class="rounded-lg border border-white/10 bg-white/[0.02] p-4 transition hover:border-emerald-400/30 hover:bg-white/[0.04]"
              >
                <p class="font-semibold text-zinc-200">{t.name}</p>
                <p class="mt-1 line-clamp-2 text-xs leading-relaxed text-zinc-500">{t.tagline}</p>
              </a>
            ))}
          </div>
        </section>
      )
    }
  </article>
</Base>

<script>
  import '../../scripts/copy';
</script>
