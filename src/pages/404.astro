---
import Base from '../layouts/Base.astro';
import { Lightbulb } from '@lucide/astro';
---

<Base title="404 — MITS">
  <div class="mx-auto max-w-2xl px-4 py-32 text-center">
    <p class="font-mono text-sm text-emerald-400">404</p>
    <h1 class="mt-3 text-3xl font-bold tracking-tight text-zinc-100">Nothing hosted here.</h1>
    <p class="mt-3 text-zinc-400">The tool you're looking for isn't in the directory — yet.</p>
    <a href="/" class="btn btn-primary mt-8">Back to explore</a>
    <a
      href="/submit"
      class="mt-4 flex items-center justify-center gap-2 font-mono text-sm text-emerald-400 hover:underline"
    >
      <Lightbulb class="size-4" aria-hidden="true" />
      Suggest it instead →
    </a>
  </div>
</Base>
