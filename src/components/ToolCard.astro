---
import { ArrowUpRight, Star } from '@lucide/astro';
import type { Tool } from '../lib/tools';
import { independenceScore, RESOURCE_SHORT, searchKeywords } from '../lib/tools';

interface Props {
  tool: Tool;
}

const { tool } = Astro.props;
const alts =
  tool.alternativeTo.length > 2
    ? `${tool.alternativeTo.slice(0, 2).join(', ')} +${tool.alternativeTo.length - 2}`
    : tool.alternativeTo.join(', ');
---

<article
  data-tool
  data-id={tool.id}
  data-name={tool.name}
  data-category={tool.category}
  data-independence={tool.independenceLevel}
  data-resource={tool.resourceRequirement}
  data-license={tool.license ?? 'null'}
  data-added={tool.addedAt}
  data-score={independenceScore(tool.independenceLevel)}
  data-featured={tool.featured ? '1' : '0'}
  data-keywords={searchKeywords(tool)}
  class="group relative flex flex-col rounded-xl border border-white/10 bg-white/[0.02] p-5 transition hover:border-emerald-400/30 hover:bg-white/[0.04]"
>
  <div class="flex items-start justify-between gap-3">
    <h3 class="font-semibold text-zinc-100">
      <a href={`/tool/${tool.id}`} class="after:absolute after:inset-0 after:content-[''] focus:outline-none">
        {tool.name}
      </a>
    </h3>
    {
      tool.featured && (
        <span class="flex items-center gap-1 rounded border border-amber-400/20 bg-amber-400/10 px-1.5 py-0.5 font-mono text-[10px] tracking-wider text-amber-300">
          <Star class="size-3" aria-hidden="true" />
          FEATURED
        </span>
      )
    }
  </div>

  <p class="mt-1.5 text-sm leading-relaxed text-zinc-400">{tool.tagline}</p>

  <div class="mt-4 flex flex-wrap gap-1.5 font-mono text-[11px]">
    <span class="rounded border border-emerald-400/20 bg-emerald-400/10 px-1.5 py-0.5 text-emerald-300">{tool.category}</span>
    <span class="rounded border border-white/10 bg-white/5 px-1.5 py-0.5 text-zinc-400">Replaces: {alts}</span>
    {
      tool.license && (
        <span class="rounded border border-sky-400/20 bg-sky-400/10 px-1.5 py-0.5 text-sky-300">{tool.license}</span>
      )
    }
  </div>

  <div class="mt-3 flex items-center justify-between text-xs text-zinc-500">
    <span>{RESOURCE_SHORT[tool.resourceRequirement]} · {tool.independenceLevel}</span>
    <span class="flex items-center gap-0.5 opacity-0 transition group-hover:opacity-100">
      details
      <ArrowUpRight class="size-3.5" aria-hidden="true" />
    </span>
  </div>
</article>
