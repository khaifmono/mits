{
  // MITS suggestion intake worker.
  // Deploys via GitHub Actions on every push to main (see README), or locally: npx wrangler deploy
  // KV namespace SUGGESTIONS is already provisioned. One secret remains:
  //   npx wrangler secret put ADMIN_TOKEN   → token required for GET /suggest (admin queue)
  "name": "mits-suggest",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "kv_namespaces": [
    {
      "binding": "SUGGESTIONS",
      "id": "01c47cda1dad4afaaf79a6c9e8f6b814"
    }
  ],
  "vars": {
    // Comma-separated origins allowed to call the API from a browser.
    "ALLOWED_ORIGINS": "https://mits.my,https://www.mits.my,https://mits.fahmiibnmazlan.workers.dev,http://localhost:4321,http://127.0.0.1:4321"
  }
}
